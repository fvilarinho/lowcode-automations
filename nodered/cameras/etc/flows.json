    {
        "id": "2aa517bf93085845",
        "type": "function",
        "z": "3c943c31a20fce2d",
        "name": "Validate the request",
        "func": "var authorization = msg.req.headers[\"authorization\"];\n\nif (authorization != null) {\n    authorization = authorization.replaceAll(\"Bearer \", \"\");\n    \n    var isValidCamera = (msg.camera != null && (msg.camera == \"office\" || msg.camera == \"bedroom\") ? true : false);\n\n    if (isValidCamera) {\n        if (authorization == env.get(msg.camera + \"_camera_token\")) {\n            if (msg.action == \"turn_on_off\") {\n                var isValidSwitch = (msg.switch != null && (msg.switch == \"on\" || msg.switch == \"off\"));\n\n                if (isValidSwitch)\n                    msg.statusCode = 200;\n                else\n                    msg.statusCode = 400;\n            }\n            else \n                msg.statusCode = 200;\n        }\n        else\n            msg.statusCode = 401;\n    }        \n    else\n        msg.statusCode = 400;\n}\nelse\n    msg.statusCode = 401;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 380,
        "wires": [
            [
                "cc416dcd7253a14a"
            ]
        ]
    },
