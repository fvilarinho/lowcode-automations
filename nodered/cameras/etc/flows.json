    {
        "id": "1217d1c09c8d82bc",
        "type": "function",
        "z": "52192d8d43a254f1",
        "name": "Set payload for the device",
        "func": "msg.camera = msg.payload.camera;\nmsg.switch = msg.payload.switch;\n\nif(msg.switch == \"on\") {\n    msg.viewport = \"<center><a href='https://\" + env.get(\"camera_hostname\") + \"/\" + msg.camera + \"' target='_\" + msg.camera + \"'>View Port</a></center>\";\n    msg.payload = env.get(\"camera_home_dir\") + \"/motion/start.sh\";\n}\nelse {\n    msg.viewport = \"\";\n    msg.payload = env.get(\"camera_home_dir\") + \"/motion/stop.sh\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 100,
        "wires": [
            [
                "d1e8047210167662"
            ]
        ]
    },
    {
